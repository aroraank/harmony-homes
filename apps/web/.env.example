# Copy to apps/web/.env.local for local development. On Netlify set these in Site settings → Environment variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase "anon" (legacy) or "publishable" key — safe in the browser because every table is protected by RLS.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Society code pre-filled on the login screen (the slug from seed.sql)
VITE_DEFAULT_SOCIETY_SLUG=plot-colony
# Web Push public key (generate with: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=
